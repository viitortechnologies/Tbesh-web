{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Open Tbesh site (browser)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Next.js: dev server"
    },
    {
      "name": "Next.js: dev server only",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev:fresh",
      "cwd": "${workspaceFolder}"
    }
  ]
}
