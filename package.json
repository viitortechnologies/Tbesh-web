{
  "name": "tbesh-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "bash scripts/dev-fresh.sh",
    "dev:fresh": "bash scripts/dev-fresh.sh",
    "dev:quick": "next dev -H 127.0.0.1 -p 3000",
    "fix-dev": "bash scripts/dev-fresh.sh",
    "clean": "rm -rf .next node_modules/.cache",
    "rebuild": "npm run clean && npm run build",
    "start:prod": "npm run build && next start -H 127.0.0.1 -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "next": "^15.3.3",
    "nodemailer": "^7.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.21",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.3",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3"
  }
}
